# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Square
SQUARE_ENV=sandbox
NEXT_PUBLIC_SQUARE_APPLICATION_ID=

# Sandbox: static access token from Square Developer Dashboard → Credentials → Sandbox
SQUARE_ACCESS_TOKEN=

# OAuth (Connect Square button): application secret from the same Credentials page
SQUARE_APPLICATION_SECRET=
SQUARE_REDIRECT_URI=http://localhost:3000/api/square/callback
